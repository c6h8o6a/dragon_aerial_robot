<?xml version="1.0"?>
<sdf version="1.7">

<model name="box">
  <static>false</static>
  <allow_auto_disable>false</allow_auto_disable>
  <!-- add_extra_module用接続位置 base_link to cog to model o-->
  <position>-0.3787 0.00004 0.08326</position>

  <link name="root">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
      <mass>1.5</mass>
      <inertia>
	<ixx>0.04887861036</ixx>
	<ixy>-0.00000002108</ixy>
	<ixz>0.00000000001</ixz>
	<iyy>0.02916393389</iyy>
	<iyz>0.00000058673</iyz>
	<izz>0.05737585629</izz>
      </inertia>
    </inertial>
    
    <collision name="collision">
      <geometry>
        <mesh>
          <uri>file:///home/newuser/ros/jsk_aerial_robot_ws/src/jsk_aerial_robot/robots/beetle/urdf/box.STL</uri>
          <scale>0.001 0.001 0.001</scale>
        </mesh>
      </geometry>

      <surface>
	<friction>
	  <ode>
	    <mu>0.01</mu>
	    <mu2>0.01</mu2>
	  </ode>
	</friction>
      </surface>
      
    </collision>

